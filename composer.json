{
    "name": "example/query-builder",
    "description": "A small, fluent, PDO-based query builder for MySQL, PostgreSQL and SQLite (PHP 5.6+)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=5.6",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "QueryBuilder\\": "src/"
        }
    },
    "scripts": {
        "lint": "find src -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
        "check": [
            "@composer validate --strict",
            "@lint"
        ]
    }
}
